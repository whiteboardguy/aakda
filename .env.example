# ── AI ────────────────────────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Tools ─────────────────────────────────────────────────────────────────────
JINA_API_KEY=
# Number of reasoning iterations (default: 8)
ITERATIONS=8

# ── Database ──────────────────────────────────────────────────────────────────
# Use "db" when running via docker-compose; use "localhost" for local dev
DATABASE_HOSTNAME=db
DATABASE_PORT=5432
DATABASE_NAME=aakda
DATABASE_USERNAME=aakda
DATABASE_PASSWORD=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECURITY_SESSION_SECRET=

# ── Instance ──────────────────────────────────────────────────────────────────
INSTANCE_URL=http://localhost:5000
INSTANCE_HOST=0.0.0.0
INSTANCE_PORT=5000
INSTANCE_VER=0.0.1

# ── Options ───────────────────────────────────────────────────────────────────
# Automatically mark new users as verified (true/false)
OPTIONS_AUTOVERIFY=false
# Days before soft-deleted conversations are permanently removed (-1 = never)
OPTIONS_PERMADELETE_WAIT_DAYS=-1
# Number of uvicorn worker processes
OPTIONS_WORKERS=1

# ── Dev ───────────────────────────────────────────────────────────────────────
DEBUG=false
